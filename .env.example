# ============================================
# Configuration du serveur FastAPI
# ============================================

# Adresse d'écoute (0.0.0.0 pour toutes les interfaces, 127.0.0.1 pour localhost uniquement)
HOST=0.0.0.0

# Port d'écoute du serveur
PORT=8001

# Mode rechargement automatique (true pour développement, false pour production)
RELOAD=false

# ============================================
# Configuration cursor-agent
# ============================================

# Mode d'intégration avec cursor-agent
# Options: cli, http, library
# - cli: Utilise cursor-agent en ligne de commande
# - http: Appelle une API HTTP cursor-agent
# - library: Utilise cursor-agent comme bibliothèque Python
CURSOR_AGENT_MODE=cli

# Configuration pour le mode CLI
# Chemin vers l'exécutable cursor-agent (optionnel, utilise "cursor-agent" par défaut si dans PATH)
# Exemples:
#   CURSOR_AGENT_CLI_PATH=cursor-agent
#   CURSOR_AGENT_CLI_PATH=/usr/local/bin/cursor-agent
#   CURSOR_AGENT_CLI_PATH=/path/to/cursor-agent
CURSOR_AGENT_CLI_PATH=cursor-agent

# Configuration pour le mode HTTP
# URL complète de l'API HTTP cursor-agent (requis si CURSOR_AGENT_MODE=http)
# Exemples:
#   CURSOR_AGENT_HTTP_URL=http://localhost:3000/api/chat
#   CURSOR_AGENT_HTTP_URL=https://api.cursor-agent.com/v1/chat
CURSOR_AGENT_HTTP_URL=http://localhost:3000/api/chat

# Timeout pour les appels à cursor-agent (en secondes)
# Augmentez cette valeur si cursor-agent met du temps à répondre
CURSOR_AGENT_TIMEOUT=60

# ============================================
# Configuration de l'API
# ============================================

# Titre de l'API (affiché dans la documentation Swagger/ReDoc)
API_TITLE=Cursor Agent API Proxy

# Version de l'API
API_VERSION=1.0.0

# Description de l'API (affichée dans la documentation)
API_DESCRIPTION=Proxy FastAPI pour cursor-agent compatible avec l'API OpenAI

# ============================================
# Sécurité
# ============================================

# Clé API pour l'authentification de VOTRE API proxy (optionnel mais recommandé en production)
# ⚠️  IMPORTANT: Ce n'est PAS une clé liée à cursor-agent ou Cursor l'éditeur
# C'est une clé que VOUS générez pour protéger votre API proxy FastAPI
# 
# Si défini, toutes les requêtes devront inclure: Authorization: Bearer <API_KEY>
# Laissez vide pour désactiver l'authentification (développement uniquement)
# 
# Pour générer une clé sécurisée:
#   python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
#   ou utilisez: just setup-env
API_KEY=

# Exemple avec une clé générée (à remplacer par votre propre clé):
# API_KEY=sk-1234567890abcdefghijklmnopqrstuvwxyz

# ============================================
# Authentification cursor-agent (si nécessaire)
# ============================================

# Si cursor-agent lui-même nécessite un token API pour s'authentifier,
# ajoutez-le ici et adaptez les fonctions d'intégration dans main.py
# Ceci est différent de API_KEY ci-dessus (qui protège votre proxy)
# CURSOR_AGENT_TOKEN=votre-token-cursor-agent-si-necessaire

# ============================================
# Logging
# ============================================

# Niveau de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Affiche tous les détails (développement)
# - INFO: Informations générales (production)
# - WARNING: Avertissements uniquement
# - ERROR: Erreurs uniquement
LOG_LEVEL=INFO
