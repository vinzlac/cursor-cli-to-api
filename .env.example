# ============================================
# Configuration du serveur FastAPI
# ============================================

# Adresse d'?coute (0.0.0.0 pour toutes les interfaces, 127.0.0.1 pour localhost uniquement)
HOST=0.0.0.0

# Port d'?coute du serveur
PORT=8000

# Mode rechargement automatique (true pour d?veloppement, false pour production)
RELOAD=false

# ============================================
# Configuration cursor-agent
# ============================================

# Mode d'int?gration avec cursor-agent
# Options: cli, http, library
# - cli: Utilise cursor-agent en ligne de commande
# - http: Appelle une API HTTP cursor-agent
# - library: Utilise cursor-agent comme biblioth?que Python
CURSOR_AGENT_MODE=cli

# Configuration pour le mode CLI
# Chemin vers l'ex?cutable cursor-agent (optionnel, utilise "cursor-agent" par d?faut si dans PATH)
# Exemples:
#   CURSOR_AGENT_CLI_PATH=cursor-agent
#   CURSOR_AGENT_CLI_PATH=/usr/local/bin/cursor-agent
#   CURSOR_AGENT_CLI_PATH=/path/to/cursor-agent
CURSOR_AGENT_CLI_PATH=cursor-agent

# Configuration pour le mode HTTP
# URL compl?te de l'API HTTP cursor-agent (requis si CURSOR_AGENT_MODE=http)
# Exemples:
#   CURSOR_AGENT_HTTP_URL=http://localhost:3000/api/chat
#   CURSOR_AGENT_HTTP_URL=https://api.cursor-agent.com/v1/chat
CURSOR_AGENT_HTTP_URL=http://localhost:3000/api/chat

# Timeout pour les appels ? cursor-agent (en secondes)
# Augmentez cette valeur si cursor-agent met du temps ? r?pondre
CURSOR_AGENT_TIMEOUT=60

# ============================================
# Configuration de l'API
# ============================================

# Titre de l'API (affich? dans la documentation Swagger/ReDoc)
API_TITLE=Cursor Agent API Proxy

# Version de l'API
API_VERSION=1.0.0

# Description de l'API (affich?e dans la documentation)
API_DESCRIPTION=Proxy FastAPI pour cursor-agent compatible avec l'API OpenAI

# ============================================
# S?curit?
# ============================================

# Cl? API pour l'authentification de VOTRE API proxy (optionnel mais recommand? en production)
# ?  IMPORTANT: Ce n'est PAS une cl? li?e ? cursor-agent ou Cursor l'?diteur
# C'est une cl? que VOUS g?n?rez pour prot?ger votre API proxy FastAPI
# 
# Si d?fini, toutes les requ?tes devront inclure: Authorization: Bearer <API_KEY>
# Laissez vide pour d?sactiver l'authentification (d?veloppement uniquement)
# 
# Pour g?n?rer une cl? s?curis?e:
#   python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
#   ou utilisez: just setup-env
API_KEY=

# Exemple avec une cl? g?n?r?e (? remplacer par votre propre cl?):
# API_KEY=sk-1234567890abcdefghijklmnopqrstuvwxyz

# ============================================
# Authentification cursor-agent (si n?cessaire)
# ============================================

# Si cursor-agent lui-m?me n?cessite un token API pour s'authentifier,
# ajoutez-le ici et adaptez les fonctions d'int?gration dans main.py
# Ceci est diff?rent de API_KEY ci-dessus (qui prot?ge votre proxy)
# CURSOR_AGENT_TOKEN=votre-token-cursor-agent-si-necessaire

# ============================================
# Logging
# ============================================

# Niveau de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Affiche tous les d?tails (d?veloppement)
# - INFO: Informations g?n?rales (production)
# - WARNING: Avertissements uniquement
# - ERROR: Erreurs uniquement
LOG_LEVEL=INFO
